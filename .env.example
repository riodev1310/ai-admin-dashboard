NEXT_PUBLIC_APP_NAME=GOLD AI Console
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Default fallback (khi registry chưa load)
NEXT_PUBLIC_DATA_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:8002

# Service Registry (tuỳ chọn, nếu có config server)
# Ví dụ config server trả về registry theo tenant:
# GET http://localhost:9000/tenants/{tenant}/services
NEXT_PUBLIC_REGISTRY_URL=http://localhost:9000
NEXT_PUBLIC_REGISTRY_PATH=/tenants/{tenant}/services

# Tenant default (khi không có subdomain)
NEXT_PUBLIC_DEFAULT_TENANT=default